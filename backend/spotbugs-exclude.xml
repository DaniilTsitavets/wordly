<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- DTOs and JPA entities expose mutable references by design in Spring Boot -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Spring-managed beans are not vulnerable to finalizer attacks -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
